pipeline {
    agent any

    triggers {
        githubPush()
    }

    environment {
        TARGET = "ubuntu@3.110.118.241"
    }

    stages {
        stage("Clone Repository") {
            steps {
                git url: "https://github.com/Iamrutujathombare/static-website-project.git", branch: "main"
            }
        }

        stage("Deploy to EC2") {
            steps {
                sshagent(credentials: ['node-key']) {
                    sh """
                    ssh -o StrictHostKeyChecking=no ubuntu@3.110.118.241 "sudo rm -rf /var/www/html"
                    ssh -o StrictHostKeyChecking=no $TARGET 'sudo git clone https://github.com/Iamrutujathombare/static-website-project.git /var/www/html'
                    ssh -o StrictHostKeyChecking=no $TARGET 'sudo systemctl restart apache2'
                    """
                }
            }
        }
    }
}